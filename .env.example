# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...            # server only, never NEXT_PUBLIC_

# --- AI ---
ANTHROPIC_API_KEY=sk-ant-...                 # required for photo analysis
MACROTRACK_MODEL=claude-opus-5               # optional override
MACROTRACK_EFFORT=medium                     # low | medium | high | xhigh | max

# --- Nutrition databases ---
USDA_API_KEY=                                # optional; Open Food Facts needs no key

# --- Web Push (generate with: npx web-push generate-vapid-keys) ---
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# --- Shared secret the pg_cron jobs send to the Edge Functions ---
# Also set as a Supabase function secret and stored in Vault (npm run setup:cron).
CRON_SECRET=
