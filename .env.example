# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...            # LOCAL SCRIPTS ONLY (seed, setup:cron).
                                             # The app never uses it — do not put it
                                             # on your web host.

# --- AI ---
ANTHROPIC_API_KEY=sk-ant-...                 # required for photo analysis
MACROTRACK_MODEL=claude-opus-5               # optional override
MACROTRACK_EFFORT=medium                     # low | medium | high | xhigh | max

# --- Nutrition databases ---
USDA_API_KEY=                                # optional; Open Food Facts needs no key

# --- Web Push (generate with: npx web-push generate-vapid-keys) ---
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Private half + cron secret live in Supabase (function secrets + Vault), not
# on the web host. They are here only so the setup scripts can install them.
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# --- Email (Supabase Auth SMTP; read by `supabase config push`) ---
# The built-in mailer cannot be templated on the free tier, so a real provider
# is required for the sign-in code to appear in the email at all.
# Gmail: needs 2FA on the account, then an App Password (16 chars, no spaces)
# from https://myaccount.google.com/apppasswords
MAIL_FROM=you@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx

# --- Shared secret the pg_cron jobs send to the Edge Functions ---
# Also set as a Supabase function secret and stored in Vault (npm run setup:cron).
CRON_SECRET=

# Deploying? The web host needs only the four NEXT_PUBLIC_* values plus
# ANTHROPIC_API_KEY. Everything else stays local or inside Supabase.

# Where trial users are told to write for a paid account. Also set it in the
# database: update public.app_settings set contact_email = 'you@example.com';
CONTACT_EMAIL=
